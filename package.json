{
  "name": "jarvis",
  "version": "0.1.0",
  "description": "J.A.R.V.I.S — a voice-activated, always-on-screen autonomous desktop assistant that can see your screen and control your Mac.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dev": "node build.mjs --watch",
    "check": "esbuild src/_selftest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_selftest.js --log-level=error && node dist/_selftest.js",
    "typecheck": "tsc --noEmit",
    "waketest": "esbuild src/_waketest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_waketest.js --log-level=error && node dist/_waketest.js",
    "miccheck": "esbuild src/_miccheck.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_miccheck.js --log-level=error && node dist/_miccheck.js",
    "e2e": "esbuild src/_e2e.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_e2e.js --log-level=error && node dist/_e2e.js",
    "hudpreview": "node scripts/preview_hud.mjs",
    "permissions": "node scripts/permissions.mjs",
    "login": "node scripts/login.mjs",
    "doctor": "npm run permissions && node scripts/doctor.mjs",
    "clean": "rm -rf dist",
    "risktest": "esbuild src/_risktest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_risktest.js --log-level=error && node dist/_risktest.js",
    "safetytest": "esbuild src/_safetytest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_safetytest.js --log-level=error && node dist/_safetytest.js",
    "bargetest": "esbuild src/_bargetest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_bargetest.js --log-level=error && node dist/_bargetest.js",
    "axtest": "esbuild src/_axtest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_axtest.js --log-level=error && node dist/_axtest.js",
    "memtest": "esbuild src/_memtest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_memtest.js --log-level=error && node dist/_memtest.js",
    "shelltest": "esbuild src/_shelltest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_shelltest.js --log-level=error && node dist/_shelltest.js",
    "frontiertest": "esbuild src/_frontiertest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_frontiertest.js --log-level=error && node dist/_frontiertest.js",
    "voicetest": "esbuild src/_voicetest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_voicetest.js --log-level=error && node dist/_voicetest.js",
    "presencetest": "esbuild src/_presencetest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_presencetest.js --log-level=error && node dist/_presencetest.js",
    "hudtest": "esbuild src/_hudtest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_hudtest.js --log-level=error && node dist/_hudtest.js",
    "composetest": "esbuild src/_composetest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_composetest.js --log-level=error && node dist/_composetest.js",
    "overlaytest": "esbuild src/_overlaytest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_overlaytest.js --log-level=error && node dist/_overlaytest.js",
    "prosodytest": "esbuild src/_prosodytest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_prosodytest.js --log-level=error && node dist/_prosodytest.js",
    "reflextest": "esbuild src/_reflextest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_reflextest.js --log-level=error && node dist/_reflextest.js",
    "gesturetest": "esbuild src/_gesturetest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_gesturetest.js --log-level=error && node dist/_gesturetest.js",
    "setuptest": "esbuild src/_setuptest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_setuptest.js --log-level=error && node dist/_setuptest.js",
    "localtest": "esbuild src/_localtest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_localtest.js --log-level=error && node dist/_localtest.js",
    "historytest": "esbuild src/_historytest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_historytest.js --log-level=error && node dist/_historytest.js",
    "changedtest": "esbuild src/_changedtest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_changedtest.js --log-level=error && node dist/_changedtest.js",
    "displaytest": "esbuild src/_displaytest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_displaytest.js --log-level=error && node dist/_displaytest.js",
    "learntest": "esbuild src/_learntest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_learntest.js --log-level=error && JARVIS_TRAJECTORY_DIR=/tmp/jarvis-learntest node dist/_learntest.js",
    "dataset": "esbuild src/_dataset.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_dataset.js --log-level=error && node dist/_dataset.js",
    "toolspec": "esbuild src/_toolspec.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_toolspec.js --log-level=error && node dist/_toolspec.js",
    "indextest": "esbuild src/_indextest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_indextest.js --log-level=error && node dist/_indextest.js",
    "translatetest": "esbuild src/_translatetest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_translatetest.js --log-level=error && node dist/_translatetest.js",
    "dryruntest": "esbuild src/_dryruntest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_dryruntest.js --log-level=error && node dist/_dryruntest.js",
    "struggletest": "esbuild src/_struggletest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_struggletest.js --log-level=error && node dist/_struggletest.js",
    "researchtest": "esbuild src/_researchtest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_researchtest.js --log-level=error && node dist/_researchtest.js",
    "remotetest": "esbuild src/_remotetest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_remotetest.js --log-level=error && rm -rf /tmp/jarvis-remotetest && JARVIS_REMOTE_DIR=/tmp/jarvis-remotetest node dist/_remotetest.js",
    "gatetest": "esbuild src/_gatetest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_gatetest.js --log-level=error && node dist/_gatetest.js",
    "personatest": "esbuild src/_personatest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_personatest.js --log-level=error && node dist/_personatest.js",
    "scantest": "esbuild src/_scantest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_scantest.js --log-level=error && node dist/_scantest.js",
    "remoteauthtest": "esbuild src/_remoteauthtest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_remoteauthtest.js --log-level=error && rm -rf /tmp/jarvis-rauth && JARVIS_REMOTE_DIR=/tmp/jarvis-rauth node dist/_remoteauthtest.js",
    "remotesignaltest": "esbuild src/_remotesignaltest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_remotesignaltest.js --log-level=error && node dist/_remotesignaltest.js",
    "redacttest": "esbuild src/_redacttest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_redacttest.js --log-level=error && node dist/_redacttest.js",
    "companiontest": "esbuild src/_companiontest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_companiontest.js --log-level=error && node dist/_companiontest.js",
    "swarmtest": "esbuild src/_swarmtest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_swarmtest.js --log-level=error && node dist/_swarmtest.js",
    "skillstest": "esbuild src/_skillstest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_skillstest.js --log-level=error && node dist/_skillstest.js",
    "prefetchtest": "esbuild src/_prefetchtest.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/_prefetchtest.js --log-level=error && node dist/_prefetchtest.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.215",
    "@google/genai": "^2.12.0",
    "bonjour-service": "^1.4.3",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@picovoice/porcupine-node": "^3.0.0",
    "@picovoice/pvrecorder-node": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "electron": "^33.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
